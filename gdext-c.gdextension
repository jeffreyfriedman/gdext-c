[configuration]
entry_symbol = "gdextension_init"
compatibility_minimum = "4.2"

[libraries]
macos.debug.arm64 = "res://bin/libgdext-c.dylib"
macos.release.arm64 = "res://bin/libgdext-c.dylib"
macos.debug.x86_64 = "res://bin/libgdext-c.dylib"
macos.release.x86_64 = "res://bin/libgdext-c.dylib"
linux.debug.x86_64 = "res://bin/libgdext-c.dylib"
linux.release.x86_64 = "res://bin/libgdext-c.dylib"
linux.debug.arm64 = "res://bin/libgdext-c.dylib"
linux.release.arm64 = "res://bin/libgdext-c.dylib"
linux.debug.rv64 = "res://bin/libgdext-c.dylib"
linux.release.rv64 = "res://bin/libgdext-c.dylib"
windows.debug.x86_64 = "res://bin/libgdext-c.dylib"
windows.release.x86_64 = "res://bin/libgdext-c.dylib"
windows.debug.arm64 = "res://bin/libgdext-c.dylib"
windows.release.arm64 = "res://bin/libgdext-c.dylib"
